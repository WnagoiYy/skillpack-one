{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/eval-run.schema.json",
  "title": "Skill evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "dataset", "datasetDigest", "harness", "startedAt", "completedAt", "metrics", "passed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dataset": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "datasetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "registryDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "passed": { "type": "boolean" },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exampleId", "reason"],
        "properties": {
          "exampleId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

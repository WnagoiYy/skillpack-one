{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/taxonomy.schema.json",
  "title": "Capability taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "includes", "excludes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "parent": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "$ref": "#/$defs/localizedString" },
          "description": { "$ref": "#/$defs/localizedString" },
          "includes": { "$ref": "#/$defs/nonEmptyStrings" },
          "excludes": { "$ref": "#/$defs/nonEmptyStrings" },
          "boundaryExamples": { "$ref": "#/$defs/nonEmptyStrings" },
          "keywords": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "properties": { "en": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

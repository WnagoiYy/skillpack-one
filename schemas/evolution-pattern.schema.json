{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/evolution-pattern.schema.json",
  "title": "Persistent evolution knowledge pattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "summary", "problem", "rootCause", "response", "confidence", "scope", "evidence", "supersedes", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["active", "superseded", "archived"] },
    "summary": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "rootCause": { "type": "string", "minLength": 1 },
    "response": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["hypothesis", "observed", "replicated"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "packs", "harnesses"],
      "properties": {
        "skills": { "$ref": "#/$defs/idsAllowEmpty" },
        "packs": { "$ref": "#/$defs/idsAllowEmpty" },
        "harnesses": { "$ref": "#/$defs/idsAllowEmpty" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "note"],
        "properties": {
          "kind": { "enum": ["task-run", "proposal", "decision", "paper", "user-feedback"] },
          "ref": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supersedes": { "$ref": "#/$defs/idsAllowEmpty" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "idsAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/skill-effect.schema.json",
  "title": "Paired Skill effect result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "harness", "baseline", "candidate", "certifiable", "metrics", "passed", "failures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataset": { "$ref": "#/$defs/id" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "baseline": { "const": "without-skill" },
    "candidate": { "const": "with-skill" },
    "certifiable": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskCompletionLift", "rubricPassLift", "blockedRateChange"],
      "properties": {
        "taskCompletionLift": { "type": "number", "minimum": -1, "maximum": 1 },
        "rubricPassLift": { "type": "number", "minimum": -1, "maximum": 1 },
        "blockedRateChange": { "type": "number", "minimum": -1, "maximum": 1 },
        "averageCostUsdChange": { "type": "number" },
        "averageLatencyMsChange": { "type": "number" }
      }
    },
    "passed": { "type": "boolean" },
    "failures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}

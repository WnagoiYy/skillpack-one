{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-organizing-skills.dev/schemas/skill-contract.schema.json",
  "title": "Skill capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "version",
    "name",
    "summary",
    "outcomes",
    "artifacts",
    "inputs",
    "outputs",
    "preconditions",
    "failures",
    "sideEffects",
    "permissions",
    "taxonomy",
    "routing",
    "provenance",
    "evaluations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["atom", "category", "meta"] },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "$ref": "#/$defs/localizedString" },
    "summary": { "$ref": "#/$defs/localizedString" },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "inputs": { "$ref": "#/$defs/ports" },
    "outputs": { "$ref": "#/$defs/ports" },
    "preconditions": { "$ref": "#/$defs/stringArray" },
    "failures": { "$ref": "#/$defs/stringArray" },
    "sideEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "filesystem-read",
          "filesystem-write",
          "network-read",
          "network-write",
          "shell-execution",
          "external-communication",
          "financial-action",
          "destructive-action",
          "privileged-action"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "shell", "secrets", "externalCommunication"],
      "properties": {
        "network": { "enum": ["none", "read", "write"] },
        "filesystem": { "enum": ["none", "read", "workspace-write", "unrestricted-write"] },
        "shell": { "enum": ["none", "allowlisted", "unrestricted"] },
        "secrets": { "enum": ["none", "named-read"] },
        "externalCommunication": { "enum": ["none", "draft", "send"] }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryCategory", "lifecycle", "modalities", "dependencies", "risk"],
      "properties": {
        "primaryCategory": { "$ref": "#/$defs/id" },
        "secondaryCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["discover", "plan", "create", "transform", "analyze", "verify", "publish", "operate", "govern"] }
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["code", "text", "document", "table", "slide", "image", "audio", "video", "browser-state", "structured-data", "physical-proxy", "system-state"] }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tool-agnostic", "product-specific", "mcp-backed", "cli-backed", "api-backed", "harness-backed"] }
        },
        "risk": { "enum": ["read-only", "reversible-write", "external-communication", "high-stakes", "destructive", "privileged"] }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveTriggers", "negativeTriggers", "confusableWith"],
      "properties": {
        "positiveTriggers": { "$ref": "#/$defs/localizedStringArrays" },
        "negativeTriggers": { "$ref": "#/$defs/localizedStringArrays" },
        "confusableWith": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "derivedFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "atom" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "outcomes": { "type": "array", "maxItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "localizedString": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1 } },
      "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "localizedStringArrays": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "properties": {
        "en": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "$ref": "#/$defs/id" },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

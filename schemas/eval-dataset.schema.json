{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/eval-dataset.schema.json",
  "title": "Skill evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "split", "locale", "examples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "split": { "enum": ["train", "dev", "test", "adversarial", "tasks"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "protected": { "type": "boolean" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "expectedCategory", "expectedAtoms", "mustNotRoute"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "prompt": { "type": "string", "minLength": 1 },
          "expectedCategory": {
            "oneOf": [
              { "$ref": "#/$defs/id" },
              { "type": "null" }
            ]
          },
          "expectedAtoms": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "mustNotRoute": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "task": { "type": "string", "minLength": 1 },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/capability-pack.schema.json",
  "title": "Composable capability pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "atoms", "optionalMcps", "acceptanceTests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "name": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "properties": { "en": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "description": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "properties": { "en": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "optionalMcps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "specialSkills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "ordering": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": { "$ref": "#/$defs/id" },
          "after": { "$ref": "#/$defs/id" }
        }
      }
    },
    "acceptanceTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateSchema", "initialState", "patchSemantics", "historyPolicy"],
      "properties": {
        "stateSchema": { "$ref": "#/$defs/runtimePath" },
        "initialState": { "$ref": "#/$defs/runtimePath" },
        "patchSemantics": { "const": "json-merge-patch" },
        "historyPolicy": { "const": "external-audit-log" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "runtimePath": { "type": "string", "pattern": "^runtime/[a-zA-Z0-9._/-]+$" }
  }
}

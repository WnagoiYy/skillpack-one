{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WnagoiYy/skillpack-one/schemas/evolution-attempt.schema.json",
  "title": "Bounded Skill evolution attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "proposal", "createdAt", "baseRevision", "candidateRevision", "editBudget", "edits", "acceptanceRule", "selection", "protectedRegressions", "decision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "proposal": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "baseRevision": { "$ref": "#/$defs/revision" },
    "candidateRevision": { "$ref": "#/$defs/revision" },
    "editBudget": { "type": "integer", "minimum": 1, "maximum": 64 },
    "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edit" } },
    "acceptanceRule": { "const": "strict-improvement" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "before", "after"],
      "properties": {
        "dataset": { "$ref": "#/$defs/id" },
        "before": { "type": "number", "minimum": 0 },
        "after": { "type": "number", "minimum": 0 }
      }
    },
    "protectedRegressions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "rationale"],
      "properties": {
        "operation": { "enum": ["add", "delete", "replace"] },
        "path": { "type": "string", "pattern": "^/" },
        "before": { "type": "string" },
        "after": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}

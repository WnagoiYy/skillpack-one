{
  "name": "skillpack-one",
  "version": "0.1.0-alpha.11",
  "description": "Install one pack. Let it find, combine, and improve the skills you need.",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WnagoiYy/skillpack-one.git"
  },
  "homepage": "https://github.com/WnagoiYy/skillpack-one#readme",
  "bugs": {
    "url": "https://github.com/WnagoiYy/skillpack-one/issues"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "mcp",
    "skill-routing",
    "self-improving-agents"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "skillpack": "dist/src/cli.js"
  },
  "files": [
    ".agents/skills",
    ".codex-plugin",
    "skills",
    "skill-src",
    ".skill-system/knowledge",
    "catalog",
    "taxonomy",
    "packs",
    "runtime",
    "evals",
    "schemas",
    "docs",
    "paper",
    "dist/src",
    "dist/scripts",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills:generate": "tsx scripts/generate-skill-projections.ts",
    "skills:check": "tsx scripts/generate-skill-projections.ts --check",
    "check": "npm run typecheck && npm run skills:check && npm test",
    "ci": "npm run check && npm run build && npm run skillpack -- gate",
    "release:plan": "tsx scripts/prepare-npm-release.ts",
    "skillpack": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
